#!/usr/bin/env bash
# Launcher: runs the harness from source with Python 3.12+ (no install step, no dependencies).
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PY=""
for cand in "$DIR/.venv/bin/python" python3.14 python3.13 python3.12 python3; do
  p="$(command -v "$cand" 2>/dev/null)" || continue
  if "$p" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 12) else 1)' 2>/dev/null; then PY="$p"; break; fi
done
if [ -z "$PY" ]; then
  echo "wiki needs Python 3.12 or newer. Install it with 'uv python install 3.12' or from python.org." >&2
  exit 1
fi
PYTHONUNBUFFERED=1 PYTHONPATH="$DIR/src${PYTHONPATH:+:$PYTHONPATH}" exec "$PY" -m wiki_cli "$@"
